generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int       @id @default(autoincrement())
  userId      String?   @unique @map("user_id") @db.VarChar(50)
  email       String?   @unique @db.VarChar(150)
  mobile      String?   @unique @db.VarChar(15)
  isVerified  Boolean?  @default(false) @map("is_verified")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamp(6)
  details     UserDetails?
  bloodPressureReadings BloodPressureReading[]
  bloodSugarReadings BloodSugarReading[]

  @@map("users")
}

model UserDetails {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id") @db.VarChar(50)
  name      String?  @db.VarChar(150)
  age       Int?
  weightKg  Float?   @map("weight_kg")
  heightCm  Float?   @map("height_cm")
  conditions String[] @default([])
  targetWeightKg Float? @map("target_weight_kg")
  targetBP String? @map("target_bp") @db.VarChar(20)
  exerciseGoal String? @map("exercise_goal") @db.VarChar(200)
  goalNotes String? @map("goal_notes") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_details")
}

model BloodPressureReading {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(50)
  systolic   Int
  diastolic  Int
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamp(6)
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("blood_pressure_readings")
}

model BloodSugarReading {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(50)
  valueMgDl  Int      @map("value_mg_dl")
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamp(6)
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("blood_sugar_readings")
}
